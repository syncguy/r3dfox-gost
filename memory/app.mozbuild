# Indirectly necessary for chromium's lock.h, included from LogAlloc.cpp
EXPORTS.mozilla += [
    "/mozglue/misc/Printf.h",
    "/xpcom/base/Logging.h",
]

DIRS += [
    "/memory",
    "/mfbt",
    "/third_party/fmt",
]

EXPORTS.mozilla += [
    "!GeckoProcessTypes.h",
    "/mozglue/misc/DynamicallyLinkedFunctionPtr.h",
    "/mozglue/misc/IntegerPrintfMacros.h",
    "/mozglue/misc/Now.h",
    "/mozglue/misc/ProcessType.h",
    "/mozglue/misc/Sprintf.h",
    "/mozglue/misc/TimeStamp.h",
    "/mozglue/misc/Uptime.h",
]

GeneratedFile(
    "GeckoProcessTypes.h",
    script="/xpcom/build/gen_process_types.py",
    entry_point="main",
)

if CONFIG["OS_ARCH"] == "WINNT":
    EXPORTS.mozilla += [
        "/mozglue/misc/StackWalk_windows.h",
        "/mozglue/misc/StackWalkThread.h",
    ]
